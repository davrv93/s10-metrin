    "salida": "{\n  \"intro\": \"Este procedimiento guía la creación y configuración del plan de cuentas para su uso en el ERP S10.\",\n  \"pasos\": [\n    {\n      \"n\": 1,\n      \"id\": \"contabilidad.crear-plan-de-cuentas#1\",\n      \"texto\": \"Ingrese al escenario **Plan Contable** y haga clic derecho para crear un plan de cuentas.\",\n      \"fotos\": []\n    },\n    {\n      \"n\": 2,\n      \"id\": \"contabilidad.crear-plan-de-cuentas#2\",\n      \"texto\": \"Digite el nombre del plan de cuentas, que lo identificará en todos los procesos.\",\n      \"fotos\": [\n        \"32374e25876d\"\n      ]\n    },\n    {\n      \"n\": 3,\n      \"id\": \"contabilidad.crear-plan-de-cuentas#3\",\n      \"texto\": \"En el detalle, ubíquese en la pestaña **Cuentas** o **Detalle** y defina la estructura del plan de cuentas a importar.\",\n      \"fotos\": [\n        \"48cb61162668\"\n      ]\n    },\n    {\n      \"n\": 4,\n      \"id\": \"contabilidad.crear-plan-de-cuentas#4\",\n      \"texto\": \"Desde la pestaña **Detalle**, use la opción para cargar el plan de cuentas previamente trabajado.\",\n      \"fotos\": [\n        \"74a6acd3db28\"\n      ]\n    },\n    {\n      \"n\": 5,\n      \"id\": \"contabilidad.crear-plan-de-cuentas#5\",\n      \"texto\": \"En **Archivo**, use **Examinar** para ubicar la ruta del Excel y elija la **Hoja**.\",\n      \"fotos\": []\n    },\n    {\n      \"n\": 6,\n      \"id\": \"contabilidad.crear-plan-de-cuentas#6\",\n      \"texto\": \"Relacione los campos establecidos por S10 con las columnas de la hoja Excel.\",\n      \"fotos\": [\n        \"326b71a1aa07\"\n      ]\n    }\n  ]\n}",
