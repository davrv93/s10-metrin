# secretos
.env
metrin/.env
.cortex/*secret*
**/*.pem
**/*token*.json
cookies.txt
data/cookies*.txt

# entornos
.venv/
entrenamiento-metrin/.venv/
.venv-repro/
__pycache__/
.DS_Store

# índice y modelos pesados (se regeneran: index-kb, embeddings, LoRA)
metrin/datos/
*.pjge
# excepción: el router de casos de Metrín (14,5 MB, entrenamiento-router/README.md)
!metrin/modelos/router/router-s10.pjge
*.gob

# jeva.cpp: fork local de llama-server (175 MB, se clona aparte;
# el cliente Go que lo habla vive en metrin/internal/jev)
jeva.cpp/

# trazas emitidas por metrin (runtime; el visor las lee con TRAZAS_REPO=archivo)
trazas/datos/

# binarios pesados o de terceros (se regeneran con s10kb.py / youtube.py / ui.py)
entrada/
data/pdf/
data/yt/audio/
data/ui/capturas/
data/tessdata/
data/lora/crudo/
data/preguntas/crudo/
data/lora/*.jsonl
*.log

# datos que SÍ se versionan: kb/ (base de fragmentos + catálogo), banco de preguntas,
# borradores de Cortex, texto extraído y estado de programación
data/*
!data/preguntas/
!data/cortex-borradores/
!data/paginas/
!data/paginas.jsonl
!data/manifiesto.jsonl
!data/enlaces.jsonl
!data/programacion.json
!data/lora/
!data/lora/resumen.json
!data/html/
data/preguntas/crudo/

# router de casos: modelo base descargado (1 GB) y salidas del entrenamiento (se regeneran)
entrenamiento-router/base/
entrenamiento-router/salida/

# conversaciones reales de clientes (WhatsApp): datos personales, NUNCA en git
entrenamiento-router/reales/
# conjuntos generados por construir_datos.py: llevan mensajes reales; se regeneran
entrenamiento-router/datos/entrenamiento.jsonl
entrenamiento-router/datos/calibracion.jsonl
entrenamiento-router/datos/prueba.jsonl

# biblioteca de PDFs (herramientas/biblioteca.py): manuales del portal de miembros de S10, fuera de git
biblioteca/
