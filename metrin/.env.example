# Copia a .env (chmod 600) y rellena. El entorno manda sobre este fichero.

# --- Garage (S3) ---
S3_ENDPOINT=http://localhost:4790
S3_REGION=garage
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=rag-demo

# --- Embeddings: estatico (Go puro, modelos/potion-es-int8.pjge) | ollama ---
EMBED_PROVIDER=estatico
EMBED_MODELO_ESTATICO=./modelos/potion-es-int8.pjge
OLLAMA_EMBED_MODEL=nomic-embed-text

# --- LLM conversacional: ollama | mlx (mlx_lm.server del Mac con LoRA) ---
LLM_PROVIDER=ollama
MLX_URL=http://localhost:8080
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:7b
RAG_TEMPERATURA=0.2
RAG_TIMEOUT=300

# --- RAG ---
RAG_DATOS=./datos
# distancia coseno (1 - similitud) del mejor trozo por encima de la cual no se pregunta al LLM
RAG_MAX_DISTANCIA=0.80
RAG_PUERTO=4760

# --- Decisiones JEV (jeva.cpp, POST /v1/systemone) ---
# Vacío = sin decisiones JEV: el flujo de siempre no cambia.
JEV_URL=
# Modelo concreto solo si el servidor es un router con varios.
JEV_MODEL=
# JSONL donde se emite cada decisión para el visor de trazas
# (trazas/trazas.py con TRAZAS_REPO=archivo). Vacío = no emitir.
JEV_TRAZAS=./datos/trazas.jsonl
# «origen» de la traza (p. ej. reportes, metrin-chat).
JEV_ORIGEN=metrin

# --- Modo traza del chat (docs/CONTRATO-traza-metrin.md) ---
# 1|true: /ask devuelve la clave «traza» si la petición trae "traza": true y
# /health dice "traza": true. Expone puntajes internos: apagado por defecto.
METRIN_TRAZA=0

# --- V2: RAG procedural multimodal (docs/V2-RAG-PROCEDURAL.md, «Despliegue») ---
# DISPONIBLE por petición y por el selector de la página (AGENT_V2_ENABLED=true), pero la versión por defecto sigue
# siendo V1: con AGENT_VERSION=v1 y AGENT_V2_PERCENTAGE=0, una petición sin "version" es V1 byte a byte.
# v1|v2: v2 manda TODOS los turnos a la V2.
AGENT_VERSION=v1
# true: habilita el porcentaje y el campo "version" de la petición (chat de prueba y selector de la página).
AGENT_V2_ENABLED=true
# 0-100: turnos en V2 por hash estable de la conversación (solo con AGENT_V2_ENABLED=true).
AGENT_V2_PERCENTAGE=0
# Recursividad controlada: al llegar a un límite, respuesta segura (nunca un bucle).
MAX_AGENT_STEPS=5
MAX_DECISION_CALLS=4
MAX_SEARCH_ITERATIONS=2
MAX_TOOL_CALLS=5
MAX_GENERATIONS=1
MAX_REGENERATIONS=1
DECISION_TIMEOUT_MS=1500
GENERATION_TIMEOUT_MS=5000
# Motor de decisión: reglas (defecto) | local (jev-style/jeva.cpp, POST /v1/systemone) | remota | simulada.
# Un error, timeout o elección fuera de las opciones → decide reglas (queda en la traza).
DECISION_ENGINE=reglas
# Modelo del servidor de decisiones (vacío = el único que sirva; p. ej. jev-style-0.8b-decision-v3).
DECISION_MODEL=
# local: vacío = http://127.0.0.1:8765 · remota: obligatoria.
DECISION_URL=
# Modelo kNN de tipo de respuesta: .json (internal/clasificar) o el catálogo .yml (se entrena al arrancar).
# Vacío = solo reglas léxicas.
V2_TIPO_MODELO=./modelos/clasificador-tipo-respuesta-candidato.json
# PROVISIONALES (medidos en muestra; ver internal/v2/config.go y kb/catalogos/EVALUACION.md): el kNN decide su
# top-1 solo con similitud >= umbral y margen >= V2_TIPO_MARGEN sobre el top-2; si no, motor de decisión.
V2_TIPO_UMBRAL=0.40
V2_TIPO_MARGEN=0.08
V2_EVIDENCIA_MIN=0
# Búsqueda de fragmentos de la V2 (procedimiento implícito y evidencia de respaldo; metrin/eval/BUSQUEDA.md):
# hibrida = BM25F + vector del almacén + RRF (internal/busqueda) · lexica = solo el BM25 propio de la V2.
# Procedimientos, conceptos y errores frecuentes siguen con el BM25 propio en los dos modos. V1 no la usa.
V2_BUSQUEDA=hibrida
# Reranker local ENCENDIDO (llama-server --reranking con bge-reranker-v2-m3 Q4_K_M; vacío = apagado). Dónde:
#   fuera de Docker, en la Mac con Metal: http://127.0.0.1:8091 (comando en metrin/eval/BUSQUEDA.md §11.6)
#   dentro del compose: http://reranker:8080 (servicio «reranker»; ya lo pone docker-compose.yml)
#   desde un contenedor suelto hacia la Mac: http://host.docker.internal:8091
# Si falla o se pasa de RERANK_TIMEOUT_MS, la V2 sigue con el orden sin reranker y lo anota en la traza.
# Coste medido (docs/V2-RAG-PROCEDURAL.md §13): con Metal, p50 0,9 s por llamada y 540 MB; solo CPU (Docker de la Mac,
# con la máquina cargada), p50 16,7 s y hasta 782 MiB: con 3000 ms casi siempre se pasa del tiempo y degrada. En una
# CPU sin GPU de servidor NO está medido.
RERANK_URL=http://127.0.0.1:8091
RERANK_TIMEOUT_MS=3000
# Candidatos que pasan por el reranker y runas de cada uno: 20 × 800 por defecto (MRR@10 0,910 frente a 0,929 con
# 30 × 1200, a la mitad de latencia; metrin/eval/BUSQUEDA.md, «Reranker encendido»). 0 = 30 y 1200.
RERANK_TOP_N=20
RERANK_MAX_RUNAS=800
# Clases que pasan por el reranker: fragmento (búsqueda híbrida), procedimiento y concepto (ELEGIR cuál responde).
# Las tres por defecto: PAS 81,8 % frente a 60,0 % solo con fragmento, invención 0 % (metrin/eval/BUSQUEDA.md §12).
# «ninguna» = no reordena nada aunque haya RERANK_URL.
V2_RERANK_CLASES=fragmento,procedimiento,concepto
