# Copia a .env (chmod 600) y rellena. El entorno manda sobre este fichero.

# --- Garage (S3) ---
S3_ENDPOINT=http://localhost:4790
S3_REGION=garage
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=rag-demo

# --- Embeddings: estatico (Go puro, modelos/potion-es-int8.pjge) | ollama ---
EMBED_PROVIDER=estatico
EMBED_MODELO_ESTATICO=./modelos/potion-es-int8.pjge
OLLAMA_EMBED_MODEL=nomic-embed-text

# --- LLM conversacional: ollama | mlx (mlx_lm.server del Mac con LoRA) ---
LLM_PROVIDER=ollama
MLX_URL=http://localhost:8080
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:7b
RAG_TEMPERATURA=0.2
RAG_TIMEOUT=300

# --- RAG ---
RAG_DATOS=./datos
# distancia coseno (1 - similitud) del mejor trozo por encima de la cual no se pregunta al LLM
RAG_MAX_DISTANCIA=0.80
RAG_PUERTO=4760
# API admin (/admin/api: métricas, cola de aprendizaje, eventos SSE). Vacío = apagada.
RAG_ADMIN_TOKEN=
# Repaso nocturno de preguntas sin respuesta, HH:MM hora local ("off" lo apaga)
RAG_HORA_APRENDER=02:00
