# Cuenta de miembro de documentacion.s10peru.com (la de Arturo / S10).
# Abre los manuales oficiales: `s10kb.py oficial`. No se versiona.
S10_USUARIO=
S10_CLAVE=
# Segundos entre peticiones. No bajar de 1: es el sitio de un cliente.
S10_PAUSA=1.0
# Dominios desde los que se aceptan PDF (coma). Lo demás se anota y no se baja.
S10_HOSTS_PDF=s10peru.com
# Conversacional de Metrín: ollama (defecto) o mlx (mlx_lm.server del Mac con LoRA).
LLM_PROVIDER=ollama
MLX_URL=http://host.docker.internal:8080
# Visor de trazas JEV (trazas/trazas.py): puerto del host (solo 127.0.0.1).
TRAZAS_PUERTO=4761
